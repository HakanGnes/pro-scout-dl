# Copy to .env and adjust. docker compose and the Python code both read this file.
POSTGRES_USER=proscout
POSTGRES_PASSWORD=proscout
POSTGRES_DB=proscout
POSTGRES_PORT=5432

DATABASE_URL=postgresql://proscout:proscout@localhost:5432/proscout

# Only used by the integration tests. The test suite drops and recreates every
# table in this database, so it must be a separate database whose name contains "test".
# TEST_DATABASE_URL=postgresql://proscout:proscout@localhost:5432/proscout_test
